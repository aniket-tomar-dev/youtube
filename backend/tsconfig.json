{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "ts-node": {
    "files": true
  },
  "files": ["src/types/express.d.ts"],
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}


